{
  "name": "sl-gnd-dsd-districts",
  "version": "2.0.0",
  "description": "Complete, official Sri Lanka administrative divisions data — Districts (25), Divisional Secretariat Divisions (DSDs 340), and Grama Niladhari Divisions (GNDs 14,020) with official codes (LIFe, GN, MPA) and trilingual support (English, Sinhala, Tamil).",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "sri-lanka",
    "districts",
    "gnd",
    "grama-niladhari",
    "dsd",
    "divisional-secretariat",
    "provinces",
    "administrative-divisions",
    "sinhala",
    "tamil",
    "lk",
    "geo",
    "location"
  ],
  "author": "hashan-lakshitha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hashan-lakshitha/sl-gnd-dsd-districts.git"
  },
  "bugs": {
    "url": "https://github.com/hashan-lakshitha/sl-gnd-dsd-districts/issues"
  },
  "homepage": "https://github.com/hashan-lakshitha/sl-gnd-dsd-districts#readme",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
